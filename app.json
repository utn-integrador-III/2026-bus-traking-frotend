{
  "expo": {
    "name": "Bus Tracking App",
    "slug": "bus-tracking-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bustrack",
    "platforms": [
      "ios",
      "android"
    ],
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bustrack.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14213d"
      },
      "package": "com.bustrack.app"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permite usar la camara para tomar la foto de la cedula.",
          "photosPermission": "Permite seleccionar la foto de la cedula."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ]
  }
}
